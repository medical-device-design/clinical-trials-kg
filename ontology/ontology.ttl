ex:anticipatedPostingDate a owl:DatatypeProperty ;
    rdfs:label "anticipated posting date" ;
    rdfs:domain ex:OutcomeMeasure ;
    rdfs:comment "values typed xsd:gYear, xsd:gYearMonth." .
ex:armType a owl:DatatypeProperty ;
    rdfs:label "arm type" ;
