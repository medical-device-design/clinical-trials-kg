@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ex: <https://bmedesign.org/clinical-trials-kg/ns/> .

<https://bmedesign.org/clinical-trials-kg/ns/> a owl:Ontology ;
    dcterms:title "ClinicalTrials.gov Knowledge Graph vocabulary" ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    owl:versionInfo "v0.0.1" ;
    rdfs:comment "Local terms of clinical-trials-kg. Shared identifiers and provenance map to the BMEdesign core vocabulary (https://bmedesign.org/core/ns/) through bmedesign-kg mappings/clinical-trials-kg.sssom.tsv." .

# ---------------- classes ----------------
ex:AdverseEvent a owl:Class ; rdfs:label "adverse event" .
ex:AdverseEventGroup a owl:Class ; rdfs:label "adverse event group" .
ex:AdverseEventReport a owl:Class ; rdfs:label "adverse event report" .
ex:AdverseEventStatistic a owl:Class ; rdfs:label "adverse event statistic" .
ex:ArmGroup a owl:Class ; rdfs:label "arm group" .
ex:AvailableIpd a owl:Class ; rdfs:label "available IPD" .
ex:BaselineDenominator a owl:Class ; rdfs:label "baseline denominator" .
ex:BaselineGroup a owl:Class ; rdfs:label "baseline group" .
ex:BaselineMeasure a owl:Class ; rdfs:label "baseline measure" .
ex:BaselineMeasurement a owl:Class ; rdfs:label "baseline measurement" .
ex:ClinicalStudy a owl:Class ; rdfs:label "clinical study" .
ex:Condition a owl:Class ; rdfs:label "condition" .
ex:Country a owl:Class ; rdfs:label "country" .
ex:DenominatorCount a owl:Class ; rdfs:label "denominator count" .
ex:FdaSubmissionLink a owl:Class ; rdfs:label "FDA submission link" .
ex:FlowGroup a owl:Class ; rdfs:label "flow group" .
ex:FlowMilestone a owl:Class ; rdfs:label "flow milestone" .
ex:FlowPeriod a owl:Class ; rdfs:label "flow period" .
ex:FlowWithdrawal a owl:Class ; rdfs:label "flow withdrawal" .
ex:Intervention a owl:Class ; rdfs:label "intervention" .
ex:MeSHConcept a owl:Class ; rdfs:label "MeSH concept" .
ex:Organization a owl:Class ; rdfs:label "organization" .
ex:OutcomeGroup a owl:Class ; rdfs:label "outcome group" .
ex:OutcomeMeasure a owl:Class ; rdfs:label "outcome measure" .
ex:OutcomeMeasurement a owl:Class ; rdfs:label "outcome measurement" .
ex:Person a owl:Class ; rdfs:label "person" .
ex:PlannedOutcome a owl:Class ; rdfs:label "planned outcome" .
ex:Publication a owl:Class ; rdfs:label "publication" .
ex:ResultsSubmissionCycle a owl:Class ; rdfs:label "results submission cycle" .
ex:SecondaryIdentifier a owl:Class ; rdfs:label "secondary identifier" .
ex:SeeAlsoLink a owl:Class ; rdfs:label "see also link" .
ex:StatisticalAnalysis a owl:Class ; rdfs:label "statistical analysis" .
ex:StudyDocument a owl:Class ; rdfs:label "study document" .
ex:StudyOfficial a owl:Class ; rdfs:label "study official" .
ex:StudyReference a owl:Class ; rdfs:label "study reference" .
ex:StudySite a owl:Class ; rdfs:label "study site" .
ex:UnpostedResultsEvent a owl:Class ; rdfs:label "unposted results event" .
ex:ViolationEvent a owl:Class ; rdfs:label "violation event" .

# ---------------- properties ----------------
ex:acronym a owl:DatatypeProperty ;
    rdfs:label "acronym" ;
    rdfs:domain ex:ClinicalStudy ;
    rdfs:range xsd:string .
ex:affiliation a owl:DatatypeProperty ;
    rdfs:label "affiliation" ;
    rdfs:domain ex:Person ;
    rdfs:range xsd:string .
ex:allCauseMortalityComment a owl:DatatypeProperty ;
    rdfs:label "all cause mortality comment" ;
    rdfs:domain ex:AdverseEventReport ;
