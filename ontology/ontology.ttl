    rdfs:comment "used on BaselineMeasurement, OutcomeMeasurement." .
ex:ciLowerLimit a owl:DatatypeProperty ;
    rdfs:label "CI lower limit" ;
    rdfs:domain ex:StatisticalAnalysis ;
    rdfs:range xsd:decimal .
ex:ciLowerLimitComment a owl:DatatypeProperty ;
    rdfs:label "CI lower limit comment" ;
    rdfs:domain ex:StatisticalAnalysis ;
    rdfs:range xsd:string .
ex:ciNumSides a owl:DatatypeProperty ;
    rdfs:label "CI num sides" ;
    rdfs:domain ex:StatisticalAnalysis ;
    rdfs:range xsd:string .
ex:ciPercent a owl:DatatypeProperty ;
    rdfs:label "CI percent" ;
    rdfs:domain ex:StatisticalAnalysis ;
    rdfs:range xsd:decimal .
ex:ciUpperLimit a owl:DatatypeProperty ;
    rdfs:label "CI upper limit" ;
    rdfs:domain ex:StatisticalAnalysis ;
    rdfs:range xsd:decimal .
ex:ciUpperLimitComment a owl:DatatypeProperty ;
    rdfs:label "CI upper limit comment" ;
    rdfs:domain ex:StatisticalAnalysis ;
    rdfs:range xsd:string .
ex:citation a owl:DatatypeProperty ;
    rdfs:label "citation" ;
    rdfs:domain ex:StudyReference ;
    rdfs:range xsd:string .
ex:city a owl:DatatypeProperty ;
    rdfs:label "city" ;
    rdfs:domain ex:StudySite ;
